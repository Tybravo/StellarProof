# Base URL of the StellarProof backend API (Express + MongoDB, fronts the
# Soroban provenance contract index). Used by the search page to fetch real
# certificate data via GET /api/v1/certificates, and by the billing dashboard
# via GET /api/v1/users/me/subscription and GET /api/v1/users/me/invoices.
# Local development default:
NEXT_PUBLIC_API_URL=http://localhost:4000

# Expected Stellar network: mainnet | testnet | futurenet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint used by frontend/services/rpcWrapper.ts. Must be a
# public variable because it is read in the browser. When unset, the public
# endpoint for NEXT_PUBLIC_STELLAR_NETWORK is used.
NEXT_PUBLIC_STELLAR_RPC_URL=

# Soroban contract / network config (used by wallet + verification flows)
NEXT_PUBLIC_VITE_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_VITE_SOROBAN_CONTRACT_ID=
NEXT_PUBLIC_VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Soroban governance contract id, used by the governance voting flow to sign
# and submit XLM-weighted votes via Freighter.
NEXT_PUBLIC_VITE_GOVERNANCE_CONTRACT_ID=

# Soroban registry contract id, used by the Oracle staking/collateral UI to
# stake and unstake XLM collateral.
NEXT_PUBLIC_VITE_REGISTRY_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Stripe (fiat checkout, /checkout/fiat)
# ---------------------------------------------------------------------------
# PUBLIC. Stripe publishable key, shipped to the browser so Stripe.js can mount
# the hosted <PaymentElement> iframe. Get it from the Stripe Dashboard ->
# Developers -> API keys ("Publishable key"). Use the pk_test_... key outside
# production. When this is unset the checkout page renders a configuration
# notice instead of a payment form.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SERVER ONLY - never prefix this with NEXT_PUBLIC_ and never import it into a
# client component. Used exclusively by the route handlers under
# app/api/checkout/ to create and verify PaymentIntents. Get it from the Stripe
# Dashboard -> Developers -> API keys ("Secret key", sk_test_... in test mode).
STRIPE_SECRET_KEY=

# NOTE ON AVAILABILITY: the /api/checkout/* route handlers FAIL CLOSED (HTTP
# 503) whenever NODE_ENV=production, because this application has no
# server-side authentication and therefore cannot identify or authorise the
# payer. Setting the two keys above is NOT sufficient to enable card checkout
# in production. See frontend/lib/checkout/availability.ts - the single
# function isCheckoutAuthConfigured() is the intended seam to flip once real
# server-side auth exists. The flow is fully usable in development
# (pnpm --filter web dev) against Stripe test keys.
